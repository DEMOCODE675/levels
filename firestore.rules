rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function matchPath(matchId) {
      return /databases/$(database)/documents/matches/$(matchId);
    }

    function matchExists(matchId) {
      return exists(matchPath(matchId));
    }

    function matchDoc(matchId) {
      return get(matchPath(matchId));
    }

    function matchData(matchId) {
      return matchDoc(matchId).data;
    }

    function isMatchMemberById(matchId) {
      return isSignedIn()
        && matchExists(matchId)
        && request.auth.uid in matchData(matchId).members;
    }

    function isCurrentMatchMember() {
      return isSignedIn()
        && resource.data.members is list
        && request.auth.uid in resource.data.members;
    }

    function isChatUnlocked(matchId) {
      return isMatchMemberById(matchId)
        && matchData(matchId).status == 'unlocked';
    }

    function canSendFirstMessage(matchId) {
      return isMatchMemberById(matchId)
        && matchData(matchId).status == 'pending'
        && matchData(matchId).femaleUserId == request.auth.uid;
    }

    function hasBlockedUsers(matchId) {
      return matchData(matchId).blockedBy is list
        && matchData(matchId).blockedBy.size() > 0;
    }

    function swipePayloadIsValid() {
      return request.resource.data.keys().hasOnly([
          'fromUserId',
          'toUserId',
          'action',
          'createdAt',
        ])
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.action in ['like', 'skip']
        && request.resource.data.createdAt is timestamp;
    }

    function matchPayloadHasExpectedShape() {
      return request.resource.data.keys().hasOnly([
          'members',
          'memberDetails',
          'femaleUserId',
          'allowMaleFirst',
          'status',
          'firstMessageBy',
          'firstMessageAt',
          'blockedBy',
          'lastMessagePreview',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.memberDetails is map
        && request.resource.data.blockedBy is list
        && request.resource.data.blockedBy.hasOnly(request.resource.data.members)
        && request.resource.data.blockedBy.size() <= request.resource.data.members.size()
        && request.resource.data.allowMaleFirst is bool
        && request.resource.data.status in ['pending', 'unlocked', 'blocked']
        && (
          request.resource.data.firstMessageBy == null
          || request.resource.data.firstMessageBy in request.resource.data.members
        )
        && (
          request.resource.data.firstMessageAt == null
          || request.resource.data.firstMessageAt is timestamp
        )
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.femaleUserId == null
          || request.resource.data.femaleUserId in request.resource.data.members
        );
    }

    function immutableMatchFieldsUnchanged() {
      return request.resource.data.members == resource.data.members
        && request.resource.data.memberDetails == resource.data.memberDetails
        && request.resource.data.femaleUserId == resource.data.femaleUserId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          resource.data.allowMaleFirst == null
          || request.resource.data.allowMaleFirst == resource.data.allowMaleFirst
          || (resource.data.allowMaleFirst == false && request.resource.data.allowMaleFirst == true)
        );
    }

    function firstMessageUnlockTransition() {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'unlocked'
        && resource.data.firstMessageBy == null
        && request.resource.data.firstMessageBy == request.auth.uid
        && (
          (request.auth.uid == resource.data.femaleUserId)
          || (resource.data.allowMaleFirst == true && request.auth.uid != resource.data.femaleUserId)
        )
        && request.resource.data.blockedBy == resource.data.blockedBy
        && request.resource.data.lastMessagePreview is string;
    }

    function unlockedChatUpdate() {
      return resource.data.status == 'unlocked'
        && request.resource.data.status == 'unlocked'
        && request.resource.data.firstMessageBy == resource.data.firstMessageBy
        && request.resource.data.firstMessageAt == resource.data.firstMessageAt
        && request.resource.data.blockedBy == resource.data.blockedBy
        && request.resource.data.lastMessagePreview is string;
    }

    function blockTransition() {
      return request.resource.data.status == 'blocked'
        && request.resource.data.firstMessageBy == resource.data.firstMessageBy
        && request.resource.data.firstMessageAt == resource.data.firstMessageAt
        && request.resource.data.lastMessagePreview == resource.data.lastMessagePreview
        && request.resource.data.blockedBy is list
        && request.resource.data.blockedBy.hasAll(resource.data.blockedBy)
        && request.resource.data.blockedBy.hasAny([request.auth.uid])
        && request.resource.data.blockedBy.size() <= resource.data.blockedBy.size() + 1;
    }

    function validMatchUpdate() {
      return matchPayloadHasExpectedShape()
        && immutableMatchFieldsUnchanged()
        && request.resource.data.updatedAt is timestamp
        && (
          firstMessageUnlockTransition()
          || unlockedChatUpdate()
          || blockTransition()
        );
    }

    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /userSettings/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /swipes/{swipeId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow get, list, create, update: if isSignedIn();
      allow delete: if false;
    }

    match /matches/{matchId}/messages/{messageId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow create, read: if isSignedIn();
      allow update, delete: if false;
    }

    match /blocks/{blockId} {
      allow create, update, read: if isSignedIn();
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, create, update: if isSignedIn();
      allow delete: if false;
    }
  }
}
